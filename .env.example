# HiveForge Agent Configuration
HIVEFORGE_API_URL=https://hiveforge-lhu4.onrender.com
HIVEFORGE_AGENT_DID=did:hive:seismic-drift-sentinel
HIVEFORGE_API_KEY=your_api_key_here

# Agent Identity
AGENT_NAME=Quake-Drift-Sentinel
AGENT_VERSION=1.0.0

# Alert Dispatch
ALERT_WEBHOOK_URL=https://your-webhook-endpoint.example.com/alerts
ALERT_YELLOW_THRESHOLD=0.50   # 50% of allowable drift
ALERT_RED_THRESHOLD=0.80      # 80% of allowable drift
ALERT_CRITICAL_THRESHOLD=1.00 # 100% of allowable drift (code violation)

# SHM Sensor Configuration
SENSOR_POLL_INTERVAL_MS=100   # 10 Hz sensor sampling
SENSOR_GATEWAY_URL=http://iot-gateway.local:8080/sensors
SENSOR_AUTH_TOKEN=your_sensor_gateway_token_here

# Accelerometer baseline correction window (seconds)
BASELINE_CORRECTION_WINDOW_S=10

# Logging
LOG_LEVEL=info                # debug | info | warn | error
LOG_FORMAT=json               # json | text
